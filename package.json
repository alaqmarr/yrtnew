{
  "name": "yrt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:push",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "tsx src/infrastructure/db/migrate.ts",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/runner.ts",
    "update": "git stash; git pull; npm i --legacy-peer-deps; npm run db:push; npm run build; pm2 restart yrt;",
    "setup": "npm i --legacy-peer-deps; npm run db:push; npm run build; PORT=3679 pm2 start \"npm run start\" --name yrt"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
